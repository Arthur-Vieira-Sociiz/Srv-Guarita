{
  "name": "srv-guarita",
  "version": "0.1.2",
  "private": true,
  "author": "Sociiz",
  "description": "Painel desktop de monitoramento da guarita.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electronmon .",
    "build": "vite build",
    "package": "npm run build && electron-builder --win nsis --x64",
    "publish": "npm run build && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron-log": "^5.4.4",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.9.5",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.sociiz.guarita",
    "productName": "Guarita Sociiz",
    "publish": [
      {
        "provider": "github",
        "owner": "Vieirinha122",
        "repo": "srv_guarita"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
